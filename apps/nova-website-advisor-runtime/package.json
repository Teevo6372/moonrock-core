{
  "name": "@moonrock/nova-website-advisor-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "validate:staging": "tsx src/staging-validation-cli.ts",
    "record:staging-activation": "tsx src/staging-activation-record-cli.ts",
    "closeout:release-1": "tsx src/release-closeout-cli.ts",
    "inspect:ghl": "node dist/src/ghl-inspect-cli.js",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "hono": "4.10.7",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.20.0",
    "pg-mem": "3.0.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
