# Release 1 staging only. Never commit real values.
NOVA_ENVIRONMENT=staging
NOVA_PERSISTENCE_MODE=durable-staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
NOVA_OPERATOR_TOKEN=replace-with-secret-store-reference
NOVA_PUBLIC_TRAFFIC_ENABLED=false
NOVA_LIVE_PROVIDERS_ENABLED=false
NOVA_GHL_WRITES_ENABLED=false
# Comma-separated exact browser origins only. Do not use wildcards.
NOVA_ALLOWED_ORIGINS=https://moonrock-2.pages.dev
PORT=3000
