{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonrockmarketing.com/schemas/nova/knowledge-manifest/1.0.0",
  "title": "Nova Release 1 Knowledge Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleId",
    "version",
    "status",
    "publishedAt",
    "publishedBy",
    "contentHash",
    "classification",
    "sources",
    "artifacts"
  ],
  "properties": {
    "bundleId": {
      "const": "nova-website-advisor-r1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["candidate", "approved", "superseded", "retired"]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approvedBy": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "classification": {
      "const": "public-approved"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "unresolvedConflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "title",
        "authorityClass",
        "version",
        "status",
        "owner",
        "effectiveAt",
        "reviewAt",
        "publicApproved"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "authorityClass": {
          "enum": ["controlling", "authoritative", "operational", "advisory"]
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "approved"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 200},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "reviewAt": {"type": "string", "format": "date-time"},
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "publicApproved": {"const": true},
        "sourcePath": {"type": "string", "maxLength": 500},
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "mediaType", "hash", "recordCount"],
      "properties": {
        "name": {
          "enum": [
            "persona",
            "intents",
            "discovery",
            "offers",
            "resources",
            "faqs",
            "policies",
            "routing",
            "escalations"
          ]
        },
        "path": {"type": "string", "pattern": "^[a-z0-9/_-]+\\.json$"},
        "mediaType": {"const": "application/json"},
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recordCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}

